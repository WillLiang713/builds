# Copy to .env only if you want to override defaults.

# Match the local user by default so files created by the container remain editable.
LOCAL_UID=1000
LOCAL_GID=1000

UPSTREAM_REPO=https://github.com/padavanonly/immortalwrt-mt798x-6.6.git

# Empty means the scripts choose a Filogic base defconfig from the selected
# device DTS. Set an explicit path only when you need to override that choice.
BASE_DEFCONFIG=

# Empty means: use the upstream default branch on first clone, then keep the
# existing checkout. Set a branch, tag, or commit for reproducible builds.
UPSTREAM_REF=

# Normally written by the interactive menu.
DEVICE_PROFILE=

NIKKI_FEED_NAME=nikki
NIKKI_FEED_URL=https://github.com/nikkinikki-org/OpenWrt-nikki.git
NIKKI_FEED_BRANCH=main
NIKKI_MIHOMO_PROVIDER=mihomo-meta
# On-device opkg binary feed host (official signed packages). Compile still uses NIKKI_FEED_URL.
NIKKI_OPKG_REPO=https://nikkinikki.pages.dev

# LuCI for Tailscale community panel (daemon itself comes from the packages feed).
TAILSCALE_LUCI_URL=https://github.com/Tokisaki-Galaxy/luci-app-tailscale-community.git
TAILSCALE_LUCI_BRANCH=master
# On-device opkg feed host for upgrading luci-app-tailscale-community (+ i18n).
TAILSCALE_OPKG_REPO=https://Tokisaki-Galaxy.github.io/luci-app-tailscale-community

# USB shared-/64 IPv6 first-boot defaults (docs/f50-ipv6.md).
# Default ON for TR3000: USB NIC eth2, IPv4 iface USB, IPv6 iface USB6.
USB_IPV6_ENABLE=1
USB_DEVICE=eth2
USB_IPV4_IFACE=USB
USB_IPV6_IFACE=USB6

# Empty means the scripts use nproc inside the container.
JOBS=
BUILD_VERBOSE=0
