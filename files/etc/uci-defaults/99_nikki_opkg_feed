#!/bin/sh
# Configure Nikki's official signed binary feed for opkg.
#
# Compiling nikki from src-git makes OpenWrt emit a distfeeds entry under
# VERSION_REPO (.../packages/$ARCH/nikki). ImmortalWrt mirrors do not host
# that third-party feed. Point devices at nikkinikki.pages.dev instead.

[ -f /etc/openwrt_release ] || exit 0
. /etc/openwrt_release

# Drop auto-generated VERSION_REPO nikki lines (enabled or commented).
if [ -f /etc/opkg/distfeeds.conf ]; then
	sed -i \
		-e '/_nikki[[:space:]]/d' \
		-e '/\/packages\/[^/]*\/nikki$/d' \
		/etc/opkg/distfeeds.conf
fi

[ -x /bin/opkg ] || exit 0

arch="${DISTRIB_ARCH:-}"
[ -n "$arch" ] || exit 0

branch=
case "${DISTRIB_RELEASE:-}" in
*"24.10"*)
	branch="openwrt-24.10"
	;;
*"25.12"*)
	branch="openwrt-25.12"
	;;
"SNAPSHOT")
	branch="SNAPSHOT"
	;;
*)
	# Unsupported release for the official binary feed; packages remain
	# preinstalled from the image build.
	exit 0
	;;
esac

repository_url="https://nikkinikki.pages.dev"
feed_url="${repository_url}/${branch}/${arch}/nikki"

mkdir -p /etc/opkg
touch /etc/opkg/customfeeds.conf
if grep -q nikki /etc/opkg/customfeeds.conf 2>/dev/null; then
	sed -i '/nikki/d' /etc/opkg/customfeeds.conf
fi
echo "src/gz nikki ${feed_url}" >> /etc/opkg/customfeeds.conf

exit 0
